{
  "base_model": "Qwen/Qwen2.5-0.5B-Instruct",
  "sft_dataset_file": "train_sft.jsonl",
  "training_hyperparameters": {
    "seed": 42,
    "epochs": 3,
    "max_steps": 320,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "effective_batch_size": 16,
    "learning_rate": 0.0002,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.05,
    "optimizer": "paged_adamw_8bit",
    "fp16": true,
    "max_seq_length": 1536
  },
  "peft_lora_config": {
    "r": 16,
    "lora_alpha": 32,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM"
  }
}